<?xml version="1.0" encoding="utf-8"?>
<!--
  Permissions are minimal and each is requested only when the feature that needs it is turned on (UX-11, NT-01).
  Never READ_SMS or RECEIVE_SMS (CLAUDE.md rule 6). Network is for opt-in sync only; everything works offline.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Camera is optional: receipt scanning uses the system camera app through an intent. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
    </queries>

    <application
        android:name=".PennyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/brand_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Penny"
        tools:targetApi="34">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- WG-03 deep links: penny://add?amount=…&category=…, penny://home, penny://review, penny://activity -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="penny" />
            </intent-filter>
        </activity>

        <!-- CP-05 / UX-09 share-sheet intake: text, images, PDFs and CSV land in the review queue or import. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Penny">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>


        <!-- WG-01 widgets -->
        <receiver android:name=".glance.SafeWidgetReceiver" android:exported="true" android:label="@string/widget_safe_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_safe" />
        </receiver>
        <receiver android:name=".glance.QuickAddWidgetReceiver" android:exported="true" android:label="@string/widget_quick_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick" />
        </receiver>
        <receiver android:name=".glance.EnvelopesWidgetReceiver" android:exported="true" android:label="@string/widget_envelopes_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_envelopes" />
        </receiver>


        <!-- M6 automation: add-only intents for Tasker and similar apps; ignored unless the user allows them. -->
        <receiver android:name=".automation.AutomationReceiver" android:exported="true">
            <intent-filter>
                <action android:name="app.penny.action.ADD_TRANSACTION" />
            </intent-filter>
        </receiver>
        <!-- WG-03 Quick Settings tile -->
        <service
            android:name=".QuickAddTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_penny"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>

        <!-- WG-02 phone side of the watch app: answers safe-to-spend and receives quick adds over the Data Layer. -->
        <service android:name=".wear.PhoneWearService" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/penny" />
            </intent-filter>
        </service>
        <!-- WorkManager is initialised by PennyApp with the Hilt worker factory. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data android:name="androidx.work.WorkManagerInitializer" android:value="androidx.startup" tools:node="remove" />
        </provider>
    </application>
</manifest>
