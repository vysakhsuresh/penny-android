<?xml version="1.0" encoding="utf-8"?>
<!-- The Penny coin in polished gold: ring with a centre dot and a soft shadow for depth. Stays inside the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- shadow -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#73000000"
        android:strokeWidth="7"
        android:pathData="M54,32.5a24,24 0,1 1,0 48a24,24 0,1 1,0 -48z" />
    <path
        android:fillColor="#73000000"
        android:pathData="M54,48.5a8,8 0,1 1,0 16a8,8 0,1 1,0 -16z" />
    <!-- coin: metallic gold, light at the top left, deeper at the bottom right -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="6.5"
        android:pathData="M54,30a24,24 0,1 1,0 48a24,24 0,1 1,0 -48z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="40" android:startY="27"
                android:endX="68" android:endY="81">
                <item android:offset="0" android:color="#FFFFF0B8" />
                <item android:offset="0.5" android:color="#FFF0C04A" />
                <item android:offset="1" android:color="#FFB8801C" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M54,46a8,8 0,1 1,0 16a8,8 0,1 1,0 -16z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="48" android:startY="46"
                android:endX="60" android:endY="62">
                <item android:offset="0" android:color="#FFFFF0B8" />
                <item android:offset="0.5" android:color="#FFF0C04A" />
                <item android:offset="1" android:color="#FFB8801C" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
