<?xml version="1.0" encoding="utf-8"?>
<!-- Shown in the home-screen widget picker before the widget is added. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_preview_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/widget_safe_label" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
        android:text="@string/widget_safe_desc" android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
        <View android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="10dp" android:background="@drawable/widget_preview_bar" />
</LinearLayout>
