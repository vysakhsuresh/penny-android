<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="exchange_rates">환율</string>
    <string name="rates_body">Penny는 각 거래 날짜의 환율로 환산해요. 기준 환율은 Wi-Fi에서 내려받아 휴대폰에 보관하며, 직접 입력한 환율이 항상 우선이에요.</string>
    <string name="rates_updated">기준 환율 (%1$s까지)</string>
    <string name="rates_never">아직 내려받은 기준 환율이 없어요</string>
    <string name="rates_refreshed">환율을 업데이트했어요</string>
    <string name="rates_offline">환율 출처에 연결하지 못했어요. Wi-Fi에서 다시 시도하세요.</string>
    <string name="refresh_now">지금 새로고침</string>
    <string name="add_manual_rate">내 환율 추가</string>
    <string name="your_currencies">오늘의 내 통화</string>
    <string name="no_rate">환율 없음</string>
    <string name="manual_rates">내 환율</string>
    <string name="no_manual_rates">아직 없어요. 은행이나 환전소에서 다른 환율을 적용받았다면 추가하세요.</string>
    <string name="rate_in_x">1단위의 %1$s 기준 가치</string>
    <string name="record_value">가치 기록</string>
    <string name="record_value_body">지금 가치는 얼마인가요? 가치 기록은 순자산에 반영돼요.</string>
    <string name="value_recorded">가치를 기록했어요</string>
    <string name="valuations">가치 평가</string>
    <string name="share_group_link">앱이 없는 사람에게 보기 공유</string>
