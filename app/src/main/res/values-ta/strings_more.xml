    <string name="app_lock">ஆப் பூட்டு</string>
    <string name="app_lock_hint">Penny திறக்கும்போது உங்கள் PIN அல்லது கைரேகையைக் கேட்கும். சமீபத்திய ஆப்கள் திரையில் தொகைகள் மறைக்கப்படும்.</string>
