    <string name="join">சேர்</string>
    <string name="joined_wait_key">சேர்ந்துவிட்டீர்கள். ஓர் உறுப்பினரின் ஃபோன் சாவியைப் பகிர்ந்த பிறகு, வழக்கமாகச் சில நிமிடங்களில், இடம் தோன்றும்.</string>
