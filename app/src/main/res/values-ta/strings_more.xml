    <!-- Sync, spaces, Plus -->
    <string name="local_only">இந்த ஃபோனில் மட்டும்</string>
    <string name="local_only_body">கணக்கு இல்லாமலேயே அனைத்தும் இயங்கும். பல சாதனங்களில் Penny-ஐப் பயன்படுத்த, பட்ஜெட்டைப் பகிர, அல்லது ஃபோனுக்கு வெளியே ஒரு நகலை வைத்திருக்க ஒத்திசைவை இயக்கவும்.</string>
    <string name="turn_on_sync">ஒத்திசைவை இயக்கு</string>
    <string name="relay_server_optional">ஒத்திசைவு சர்வர் (விருப்பத்தேர்வு)</string>
    <string name="relay_server_hint">Penny-இன் சர்வருக்குக் காலியாக விடவும், அல்லது உங்கள் சொந்த சர்வரை உள்ளிடவும்.</string>
