    <string name="delete_sync_account">என் ஒத்திசைவுக் கணக்கை நீக்கு</string>
    <string name="delete_sync_account_body">ஒத்திசைக்கப்பட்ட உங்கள் தரவு 24 மணி நேரத்துக்குள் சர்வரிலிருந்து நீக்கப்படும். இந்த ஃபோனில் உள்ள தரவு நீங்கள் நீக்கும் வரை இருக்கும்.</string>
    <string name="bank_sync">வங்கி இணைப்புகள்</string>
    <string name="bank_sync_body">பரிவர்த்தனைகளைத் தானாகக் கொண்டுவர, ஒழுங்குமுறைக்கு உட்பட்ட வழங்குநர் மூலம் வங்கியை இணைக்கவும். உங்கள் வங்கி உள்நுழைவு இந்த ஃபோனையோ Penny சர்வர்களையோ ஒருபோதும் தொடாது.</string>
    <string name="providers_here">உங்கள் பகுதியில் கிடைப்பவை: %1$s</string>
    <string name="advisor_links">ஆலோசகருடன் பகிர்</string>
    <string name="advisor_body">கணக்காளர், ஆலோசகர் அல்லது குடும்பத்தினருக்காக, சுருக்கத்துடன் கூடிய பார்க்க மட்டுமான இணைப்பை உருவாக்கவும். அது தானாகக் காலாவதியாகும், கணக்கு இல்லாமலேயே திறக்கும்.</string>
    <string name="advisor_needs_sync">முதலில் ஒத்திசைவை இயக்கவும்.</string>
    <string name="link_lasts">இணைப்பின் காலம்</string>
    <string name="create_advisor_link">இணைப்பை உருவாக்கு</string>
    <string name="spaces_body">பகிரப்பட்ட இடம் என்பது மற்றவர்களுடன் பகிரும் பட்ஜெட்; ஒவ்வொருவருக்கும் தனி உள்நுழைவும் பங்கும் உண்டு. அதில் உள்ள அனைத்தும் முழுமையாக என்க்ரிப்ட் செய்யப்பட்டது.</string>
    <string name="spaces_need_sync">பகிரப்பட்ட இடங்களுக்கு ஒத்திசைவு இயக்கத்தில் இருக்க வேண்டும்.</string>
