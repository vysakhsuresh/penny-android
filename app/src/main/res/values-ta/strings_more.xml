    <string name="help_request">உதவிக் கோரிக்கை</string>
    <string name="bug_report">சிக்கல் அறிக்கை</string>
    <string name="feature_idea">யோசனை</string>
    <string name="guides_intro">Penny-ஐ முழுமையாகப் பயன்படுத்தச் சிறு வழிகாட்டிகள். ஆஃப்லைனிலும் வேலை செய்யும்.</string>
    <string name="guide_start_title">இரண்டு நிமிடத்தில் தொடங்குதல்</string>
    <string name="guide_safe_title">“செலவிடக்கூடியது” என்றால் என்ன</string>
    <string name="guide_budget_title">என்வலப்புகளுடன் பட்ஜெட்</string>
    <string name="guide_cycle_title">உண்மையான சம்பளச் சுழற்சியில் பட்ஜெட்</string>
    <string name="guide_capture_title">பரிவர்த்தனைகள் உங்களிடம் வரட்டும்</string>
