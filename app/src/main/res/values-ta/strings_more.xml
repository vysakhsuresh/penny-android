    <string name="verify">சரிபார்</string>
    <string name="sync_privacy">தரவு அனுப்பப்படும் முன் இந்த ஃபோனிலேயே என்க்ரிப்ட் செய்யப்படுகிறது. சர்வர் தன்னால் படிக்க முடியாத குழப்பிய தரவை மட்டுமே சேமிக்கிறது.</string>
    <string name="sync_error">ஒத்திசைவுச் சிக்கல்: %1$s</string>
    <string name="recovery_phrase">மீட்புச் சொற்றொடர்</string>
    <string name="enter_phrase_body">முதன்முதலில் ஒத்திசைவை இயக்கியபோது எழுதி வைத்த 24 சொற்களைத் தட்டச்சு செய்யவும். அவை இந்தச் சாதனத்தில் உங்கள் தரவைத் திறக்கும்.</string>
    <string name="wrong_phrase">அந்தச் சொற்கள் உங்கள் தரவைத் திறக்கவில்லை. ஒவ்வொரு சொல்லையும் சரிபார்க்கவும்.</string>
    <string name="new_account_phrase">எனக்குப் புதிய சொற்றொடர் வேண்டும்</string>
    <string name="phrase_body">இந்த 24 சொற்களை எழுதிப் பாதுகாப்பாக வைத்திருங்கள். புதிய ஃபோனில் உங்கள் தரவைத் திறக்கவோ என்க்ரிப்ட் செய்யப்பட்ட காப்புப்பிரதியை மீட்டமைக்கவோ இதுவே ஒரே வழி. Penny-ஆல் இவற்றை உங்களுக்காக மீட்க முடியாது.</string>
