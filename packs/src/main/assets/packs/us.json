  "notification_templates": [
    {
      "id": "us_sent_you",
      "packages": [
        "com.venmo",
        "com.squareup.cash",
        "com.paypal.android.p2pmobile",
        "com.chase.sig.android"
      ],
      "regex": "(?<payee>[^\\n$]+?)\\s+(?:sent|paid)\\s+you\\s+\\$(?<amount>[0-9][0-9,]*(?:\\.[0-9]{1,2})?)",
      "type": "income",
      "currency": "USD",
      "numberLocale": "en",
      "confidence": 90
    },
    {
      "id": "us_received_from",
      "packages": [
        "com.squareup.cash",
        "com.paypal.android.p2pmobile",
        "com.chase.sig.android"
      ],
      "regex": "You(?:\\'ve)? received\\s+\\$(?<amount>[0-9][0-9,]*(?:\\.[0-9]{1,2})?)(?:\\s+USD)?\\s+from\\s+(?<payee>[^\\n]+?)(?=\\s+(?:on|via|using|with|for|ref|upi)\\b|[.!,]?\\s*(?:\\n|$))",
      "type": "income",
      "currency": "USD",
      "numberLocale": "en",
      "confidence": 90
    },
    {
      "id": "us_venmo_paid",
      "packages": [
        "com.venmo"
      ],
      "regex": "You paid\\s+(?<payee>[^\\n$]+?)\\s+\\$(?<amount>[0-9][0-9,]*(?:\\.[0-9]{1,2})?)",
      "type": "expense",
      "currency": "USD",
      "numberLocale": "en",
      "confidence": 90
    },
    {
      "id": "us_sent_to",
      "packages": [
        "com.squareup.cash",
        "com.paypal.android.p2pmobile",
        "com.chase.sig.android"
      ],
      "regex": "You (?:sent|paid)\\s+\\$(?<amount>[0-9][0-9,]*(?:\\.[0-9]{1,2})?)(?:\\s+USD)?\\s+to\\s+(?<payee>[^\\n]+?)(?=\\s+(?:on|via|using|with|for|ref|upi)\\b|[.!,]?\\s*(?:\\n|$))",
      "type": "expense",
      "currency": "USD",
      "numberLocale": "en",
      "confidence": 90
    },
    {
      "id": "us_chase_card",
      "packages": [
        "com.chase.sig.android"
      ],
      "regex": "(?:You made an?|An?)\\s+\\$(?<amount>[0-9][0-9,]*(?:\\.[0-9]{1,2})?)\\s+[a-z ,]*?transaction\\s+with\\s+(?<payee>[^\\n]+?)(?=\\s+on\\s|[.!,]?\\s*(?:\\n|$))",
      "type": "expense",
      "currency": "USD",
      "numberLocale": "en",
      "confidence": 88
    }
  ],
